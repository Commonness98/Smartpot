# 환경변수 예시. 이 파일을 .env 로 복사해서 사용한다(.env는 커밋되지 않음).

# --- 로컬 LLM 백엔드 (OpenAI 호환) ---
# Ollama 사용 시(기본). 설치: winget install Ollama.Ollama
#   ollama pull qwen2.5:3b
LM_STUDIO_BASE_URL=http://localhost:11434/v1
LM_STUDIO_MODEL=qwen2.5:3b
LM_STUDIO_API_KEY=ollama

# LM Studio 사용 시에는 아래로 교체
# LM_STUDIO_BASE_URL=http://localhost:1234/v1
# LM_STUDIO_MODEL=local-model
# LM_STUDIO_API_KEY=lm-studio
#
# 두 백엔드 모두 꺼져 있어도 규칙 기반 응답으로 폴백해 정상 동작한다.
# llm_client가 설정된 주소를 먼저 확인하고, 응답이 없으면 알려진 로컬 백엔드를
# 자동 탐지하므로 대개는 수정 없이 동작한다.

# --- 데이터베이스 ---
# 미지정 시 SQLite(data/smartfarm.db)로 폴백한다.
# DB_URL=mysql+pymysql://user:password@localhost:3306/smartfarm

# --- 온실 재배 면적(m²) ---
# 예측 타깃이 면적당(kWh/m²/일)이라, 전체 전기요금 계산에 사용한다.
# 기본값 96.0은 WUR 챌린지 온실 구획 기준. 실제 농가 적용 시 교체.
# GREENHOUSE_AREA_M2=96.0
